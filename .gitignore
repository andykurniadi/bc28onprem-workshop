# Local workshop configuration and secrets
local-only/
.env
.env.*
!*.example.env
local.settings.json
*-values.json
!*-values.example.json
*.publishsettings

# Certificates and private keys
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.docx
*.odt
*.ps1

# Original workshop export
MS BC28 workshop.docx

# Extracted screenshots can contain tenant identifiers or other local data.
assets/screenshots/**
!assets/screenshots/.gitkeep

# PowerShell secrets and user-specific files
*.clixml
*.pscredential

# AL project generated files and local publish configuration
al-project/.alpackages/
al-project/*.app
al-project/.vscode/launch.json
al-project/backup/
al-project/.snapshots/
sourceDoc/*
.github/*


# Build and editor files
bin/
obj/
.vs/
.vscode/
